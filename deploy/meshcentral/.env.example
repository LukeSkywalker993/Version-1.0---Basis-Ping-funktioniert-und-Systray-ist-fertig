# ---------------------------------------------------------------------------
# MeshCentral – Projektteil 1
# Kopieren nach ".env", Netz prüfen und alle Werte mit "CHANGE_ME" ersetzen:
#   cp .env.example .env && nano .env
# Die .env enthält Passwörter und wird NICHT ins Git eingecheckt.
# ---------------------------------------------------------------------------

# Image-Version fest pinnen (kein "latest"), Update = bewusste Änderung hier.
MESHCENTRAL_VERSION=1.2.5

# LAN-IP des Linux-Hosts, auf dem der Container läuft.
# Nur auf dieser IP wird Port 443 veröffentlicht -> kein Bind auf 0.0.0.0.
MESH_LAN_IP=10.199.199.15

# Name/Adresse, unter der Agents und Browser den Server erreichen.
# Ohne internen DNS-Namen einfach dieselbe LAN-IP eintragen.
# Wird in das selbstsignierte Zertifikat geschrieben – später ändern
# erfordert, dass die Agents neu ausgerollt werden.
MESH_HOST=10.199.199.15

# HTTPS-Port auf dem Host (Agents + Weboberfläche + API).
MESH_PORT=443

# LAN-Netz(e), aus denen Browser, API-Clients und Agents kommen dürfen.
# Komma-getrennt, z. B. "192.168.10.0/24,10.0.5.0/24".
MESH_LAN_CIDR=10.199.199.0/24

# Aufbewahrung der Session-Recordings in Tagen (offene Entscheidung Nr. 4).
MESH_RECORDING_DAYS=90

# Name der Gerätegruppe für den Windows-Server (Projektteil 2).
MESH_DEVICE_GROUP=12ps_claude_remote

# Admin-Account für die Weboberfläche (offene Entscheidung Nr. 3).
# Passwort: mind. 12 Zeichen, Groß/Klein/Ziffer/Sonderzeichen.
MESH_ADMIN_USER=meshadmin
MESH_ADMIN_PASS=CHANGE_ME
MESH_ADMIN_EMAIL=admin@example.local

# Eingeschränkter API-Benutzer für Claude (Projektteil 3).
MESH_API_USER=claude-api

TZ=Europe/Berlin
